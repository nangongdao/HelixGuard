{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Helix Guard",
  "version": "1.4.0",
  "identifier": "com.nangongdao.helix-guard",
  "build": {
    "frontendDist": "../app/static"
  },
  "app": {
    "windows": [
      {
        "title": "Helix Guard",
        "label": "main",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/server/": "server/"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/nangongdao/HelixSupport/releases/latest/download/latest.json"
      ],
      "pubkey": ""
    }
  }
}
